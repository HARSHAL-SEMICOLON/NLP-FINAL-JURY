# Copy this file to .env and fill in your values.

# --- LLM ---------------------------------------------------------------
# groq | gemini | ollama | offline
LLM_PROVIDER=groq

# Groq (free tier, no card): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# If this name is rejected, the app automatically tries other Gemini Flash models.
GEMINI_MODEL=gemini-3.5-flash

# Local alternative (install Ollama, then: ollama pull llama3.2)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Roles / course ----------------------------------------------------
# PIN that unlocks the Faculty view (class dashboard, doubts, question papers)
FACULTY_PIN=1234
COURSE_NAME=Natural Language Processing with Large Models
COURSE_CODE=23CSE4021

# --- Retrieval ---------------------------------------------------------
# auto = Sentence Transformers if installed, else TF-IDF.  Or: sbert | tfidf
EMBEDDING_BACKEND=auto
CHUNK_SIZE=120
CHUNK_OVERLAP=30
TOP_K=4

# --- Arduino UNO R4 WiFi -----------------------------------------------
# IP printed on the Serial Monitor after the board joins Wi-Fi. Leave empty to disable.
ARDUINO_IP=
